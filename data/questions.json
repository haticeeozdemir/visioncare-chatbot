        {"code": "preschool", "label": {"en": "Preschool child (0–6)", "tr": "Okul öncesi çocuk (0–6)", "el": "Παιδί προσχολικής ηλικίας (0–6)"}},
        {"code": "school_age", "label": {"en": "School-age child (7–17)", "tr": "Okul çağı çocuk (7–17)", "el": "Παιδί σχολικής ηλικίας (7–17)"}},
        {"code": "adult", "label": {"en": "Adult (18–64)", "tr": "Yetişkin (18–64)", "el": "Ενήλικας (18–64)"}},
